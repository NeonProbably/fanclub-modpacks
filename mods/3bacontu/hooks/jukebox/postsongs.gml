with new JukeboxSection("Bacon2 Mod", 4)
{
add_multisong("event:/bacon2/soundtest/teatime", "It's Tea Time!! - mizukin",
	"event:/bacon2/soundtest/old/sigmasigma", "SIGMA SIGMA ON THE WALL!! - mizukin",
"event:/bacon2/soundtest/old/sigmasigmaold", "SIGMA SIGMA ON THE WALL!! (OLD) - mizukin")

sprite = MOD_GLOBAL.smilecodisk

add_multisong("event:/bacon2/soundtest/raisedaroof", "Raise the Roof - mizukin, validusername64",
	"event:/bacon2/soundtest/old/dingding", "DING DING, WAKE THE FUCK UP!! - mizukin",
	"event:/bacon2/soundtest/old/dingdingold", "DING DING, WAKE THE FUCK UP!! (OLD) - mizukin")




add_multisong("event:/bacon2/soundtest/news/clone", "Cosmic Clone (Bacontu's Mix) - the crum",
	"event:/bacon2/soundtest/news/escapeclone", "Cosmic Clone Escape (Bacontu's Mix) - the crum");


add_multisong("event:/bacon2/soundtest/naturesexpresso", "Nature's Expresso - mizukin",
	"event:/bacon2/soundtest/old/naturesexpresso", "Nature's Expresso (OLD) - mizukin");

add_song("event:/bacon2/soundtest/secretent", "Lost Doodle Beside the Lonel - mizukin");
add_separator();
add_multisong("event:/bacon2/soundtest/shitstreetbeat", "Shit Street Beat - mizukin",
	"event:/bacon2/soundtest/old/cityfunk2", "CityFunk2 - mizukin, dky_guy");
add_song("event:/bacon2/soundtest/shitsecret", "A doodle with some gunk around it what is that? - mizukin");
add_song("event:/bacon2/soundtest/wastedshoresWIP", "Wasted Shores WIP - mizukin");
add_separator();
add_song("event:/bacon2/soundtest/VSsmiles", "VS. Lester Smiles - mizukin");
add_song("event:/bacon2/soundtest/vacationsend", "A Vacation's End - mizukin");
add_song("event:/bacon2/soundtest/oneonlyvisitor", "Your One and Only Visitor - mizukin");
add_separator();
add_song("event:/bacon2/soundtest/ineedanapbreak", "i need a nap break - mizukin");
// fanmade name by basikru
add_song("event:/bacon2/soundtest/hubpause", "Takin' a Break at the Smile.Co Building - mizukin");
add_song("event:/bacon2/soundtest/hubsong", "EMBEZZLEDEXPIDITION.wav - mizukin");
add_song("event:/bacon2/soundtest/aquaphobia", "aquaphobia - mizukin");
}